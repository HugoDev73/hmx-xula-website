---
import SocialLinks from "../ui/SocialLinks.astro";
---

<section class="closing-section">
  <div class="closing-section__inner u-container">
    <img
      class="closing-section__mark"
      src="/images/brand/icon_agave.png"
      alt=""
      width="325"
      height="522"
      aria-hidden="true"
    />
    <p class="closing-section__eyebrow u-eyebrow">Conecta con XULA</p>
    <h2 class="closing-section__title">Descubre el carácter de XULA.</h2>
    <p class="closing-section__description">
      Síguenos para conocer lanzamientos, rituales de consumo y próximas expresiones.
    </p>
    <SocialLinks />
  </div>
</section>

<style>
  .closing-section {
    background: var(--color-surface-mid);
    padding-block: var(--space-16);
  }

  .closing-section__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: var(--space-10);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    background: var(--color-surface);
    text-align: center;
  }

  .closing-section__title {
    color: var(--color-on-surface);
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .closing-section__mark {
    width: auto;
    height: 44px;
    object-fit: contain;
  }

  .closing-section__description {
    max-width: 560px;
    color: var(--color-on-surface-muted);
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
  }
</style>
