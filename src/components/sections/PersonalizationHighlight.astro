---
import type { CollectionEntry } from "astro:content";
import Button from "../ui/Button.astro";

type ProductEntry = CollectionEntry<"products">;

type Props = {
  product: ProductEntry;
};

const { product } = Astro.props;
const { data } = product;
---

<section
  class="personalization-highlight"
  style={`
    --product-accent: ${data.accent};
    --product-accent-soft: ${data.accentSoft};
    --product-accent-container: ${data.accentContainer};
    --product-on-accent: ${data.onAccent};
  `}
>
  <div class="personalization-highlight__inner u-container">
    <div class="personalization-highlight__content">
      <p class="personalization-highlight__eyebrow u-eyebrow">Solo {data.name}</p>
      <h2 class="personalization-highlight__title">Una botella escrita para ti.</h2>
      <p class="personalization-highlight__description">
        {data.personalizationDescription}
      </p>
      <Button href={data.ctaLink} label="Solicitar personalización" variant="product" />
    </div>

    <div class="personalization-highlight__panel" aria-label="Beneficios de XULA Oro">
      {
        data.benefits.map((benefit) => (
          <div class="personalization-highlight__benefit">
            <span class="personalization-highlight__marker" aria-hidden="true" />
            <p>{benefit}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .personalization-highlight {
    background: var(--color-surface-mid);
    padding-block: var(--section-gap);
  }

  .personalization-highlight__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(280px, 1fr);
    align-items: center;
    gap: var(--space-12);
  }

  .personalization-highlight__content {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .personalization-highlight__eyebrow {
    color: var(--product-accent);
  }

  .personalization-highlight__title {
    color: var(--color-on-surface);
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .personalization-highlight__description {
    max-width: 560px;
    color: var(--color-on-surface-muted);
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
  }

  .personalization-highlight__panel {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-8);
    border: 1px solid var(--product-accent-soft);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(circle at 80% 20%, var(--product-accent-container), transparent 18rem),
      var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .personalization-highlight__benefit {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--color-on-surface);
    font-weight: var(--weight-medium);
  }

  .personalization-highlight__marker {
    width: 0.75rem;
    height: 0.75rem;
    flex: 0 0 auto;
    border-radius: var(--radius-pill);
    background: var(--product-accent);
  }

  @media (max-width: 860px) {
    .personalization-highlight__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
