---
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
---

<section class="origin-preview u-section">
  <div class="origin-preview__inner u-container">
    <div class="origin-preview__visual" aria-hidden="true">
      <span class="origin-preview__line" />
      <span class="origin-preview__line origin-preview__line--short" />
      <span class="origin-preview__line" />
    </div>

    <div class="origin-preview__content">
      <SectionHeader
        eyebrow="Nuestra tierra"
        title="Michoacán: donde el alma se hace mezcal."
        description="Tierra volcánica, agave Cupeatra y manos que honran generaciones de tradición. XULA toma ese origen como punto de partida para una expresión joven, elegante y memorable."
      />
      <div class="origin-preview__actions">
        <Button href="/acerca-de" label="Conoce nuestra historia" variant="secondary" />
      </div>
    </div>
  </div>
</section>

<style>
  .origin-preview {
    background: var(--color-surface);
  }

  .origin-preview__inner {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(0, 0.9fr);
    align-items: stretch;
    gap: var(--space-8);
  }

  .origin-preview__visual {
    display: grid;
    min-height: 360px;
    align-content: end;
    gap: var(--space-4);
    overflow: hidden;
    padding: var(--space-8);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(circle at 30% 30%, var(--color-secondary-container), transparent 18rem),
      linear-gradient(145deg, var(--color-surface-mid), var(--color-surface));
  }

  .origin-preview__line {
    display: block;
    height: 1px;
    background: color-mix(in srgb, var(--color-secondary) 45%, transparent);
  }

  .origin-preview__line--short {
    width: 72%;
  }

  .origin-preview__content {
    display: grid;
    align-content: center;
    padding: var(--space-8);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    background: var(--color-surface-mid);
  }

  .origin-preview__actions {
    margin-top: var(--space-8);
  }

  @media (max-width: 860px) {
    .origin-preview__inner {
      grid-template-columns: 1fr;
    }

    .origin-preview__visual {
      min-height: 260px;
    }
  }
</style>
