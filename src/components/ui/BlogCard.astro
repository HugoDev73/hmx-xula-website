---
import type { CollectionEntry } from "astro:content";

type BlogEntry = CollectionEntry<"blog">;

type Props = {
  post: BlogEntry;
  featured?: boolean;
};

const { post, featured = false } = Astro.props;
const { data } = post;
const formattedDate = data.date.toLocaleDateString("es-MX", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<article class:list={["blog-card", featured && "blog-card--featured"]}>
  <a class="blog-card__media" href={`/blog/${data.slug}`} aria-label={`Leer ${data.title}`}>
    <span class="blog-card__image-label">{data.category}</span>
  </a>

  <div class="blog-card__content">
    <p class="blog-card__category u-eyebrow">{data.category}</p>
    <h2 class="blog-card__title">
      <a href={`/blog/${data.slug}`}>{data.title}</a>
    </h2>
    <p class="blog-card__description">{data.description}</p>
    <p class="blog-card__meta">{formattedDate} · {data.readingTime} min de lectura</p>
  </div>
</article>

<style>
  .blog-card {
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    background: var(--color-surface-mid);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .blog-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .blog-card--featured {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(0, 1fr);
  }

  .blog-card__media {
    display: grid;
    min-height: 220px;
    place-items: end start;
    padding: var(--space-6);
    background:
      radial-gradient(circle at 18% 22%, var(--color-secondary-container), transparent 16rem),
      linear-gradient(145deg, var(--color-surface-deep), var(--color-surface-mid));
    text-decoration: none;
  }

  .blog-card--featured .blog-card__media {
    min-height: 360px;
  }

  .blog-card__image-label {
    border-radius: var(--radius-pill);
    background: var(--color-secondary);
    color: var(--color-on-secondary);
    font-size: var(--text-eyebrow);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    padding: var(--space-2) var(--space-4);
    text-transform: uppercase;
  }

  .blog-card__content {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .blog-card--featured .blog-card__content {
    align-content: center;
    padding: var(--space-8);
  }

  .blog-card__title {
    color: var(--color-on-surface);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .blog-card--featured .blog-card__title {
    font-size: var(--text-display);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .blog-card__title a {
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .blog-card__title a:hover {
    color: var(--color-secondary);
  }

  .blog-card__description {
    color: var(--color-on-surface-muted);
    font-size: var(--text-body-sm);
    line-height: var(--leading-relaxed);
  }

  .blog-card--featured .blog-card__description {
    font-size: var(--text-body-lg);
  }

  .blog-card__meta {
    color: var(--color-on-surface-muted);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
  }

  @media (max-width: 860px) {
    .blog-card--featured {
      grid-template-columns: 1fr;
    }

    .blog-card--featured .blog-card__media {
      min-height: 260px;
    }
  }
</style>
