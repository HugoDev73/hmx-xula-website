---
import { getCollection } from "astro:content";
import BrandPillars from "../components/sections/BrandPillars.astro";
import ClosingSection from "../components/sections/ClosingSection.astro";
import OriginPreview from "../components/sections/OriginPreview.astro";
import PersonalizationHighlight from "../components/sections/PersonalizationHighlight.astro";
import ProductPreview from "../components/sections/ProductPreview.astro";
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const products = await getCollection("products");
const featuredProducts = products
  .filter((product) => product.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
const personalizableProduct = products.find((product) => product.data.personalizable);
---

<BaseLayout
  title="XULA Mezcal Artesanal - Agave Cupeatra de Michoacán"
  description="XULA es un mezcal artesanal joven de agave Cupeatra, con identidad mística y elegante inspirada en Michoacán."
>
  <section class="home-hero">
    <div class="home-hero__inner u-container">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow u-eyebrow">Mezcal artesanal · Michoacán</p>
        <h1 class="home-hero__title">Mezcal artesanal con carácter místico.</h1>
        <p class="home-hero__description">
          XULA celebra el agave Cupeatra con una estética elegante, joven y seductora
          inspirada en la tradición mezcalera de Michoacán.
        </p>
        <div class="home-hero__actions">
          <Button href="/acerca-de" label="Nuestra historia" variant="secondary" />
        </div>
      </div>

      <div class="home-hero__visual" aria-hidden="true">
        <div class="home-hero__bottle-mark">XULA</div>
      </div>
    </div>
  </section>

  <BrandPillars />

  <ProductPreview products={featuredProducts} />

  {personalizableProduct && <PersonalizationHighlight product={personalizableProduct} />}

  <OriginPreview />

  <ClosingSection />
</BaseLayout>

<style>
  .home-hero {
    background:
      radial-gradient(circle at 80% 20%, rgba(7, 190, 184, 0.16), transparent 28rem),
      var(--color-surface-dark);
    color: var(--color-on-surface-dark);
  }

  .home-hero__inner {
    display: grid;
    min-height: min(720px, calc(100vh - 64px));
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.85fr);
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-24);
  }

  .home-hero__content {
    max-width: 640px;
  }

  .home-hero__title {
    max-width: 760px;
    margin-top: var(--space-4);
    color: var(--color-on-surface-dark);
    font-size: var(--text-hero);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .home-hero__description {
    max-width: 560px;
    margin-top: var(--space-6);
    color: var(--color-on-surface-dark-muted);
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .home-hero__visual {
    display: grid;
    min-height: 420px;
    place-items: center;
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-2xl);
    background:
      linear-gradient(145deg, rgba(250, 248, 244, 0.08), transparent),
      var(--color-surface-dark-mid);
    box-shadow: var(--shadow-glow-secondary);
  }

  .home-hero__bottle-mark {
    display: grid;
    width: min(58vw, 220px);
    aspect-ratio: 0.42;
    place-items: center;
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-lg);
    color: var(--color-on-surface-dark);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
  }

  @media (max-width: 860px) {
    .home-hero__inner {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: var(--space-10);
      padding-block: var(--space-16);
    }

    .home-hero__visual {
      min-height: 320px;
    }
  }
</style>
