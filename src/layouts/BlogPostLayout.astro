---
import type { CollectionEntry } from "astro:content";
import Button from "../components/ui/Button.astro";
import BaseLayout from "./BaseLayout.astro";

type BlogEntry = CollectionEntry<"blog">;

type Props = {
  post: BlogEntry;
};

const { post } = Astro.props;
const { data } = post;
const formattedDate = data.date.toLocaleDateString("es-MX", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} image={data.heroImage}>
  <article class="blog-post">
    <header class="blog-post__hero">
      <div class="blog-post__hero-inner u-container">
        <p class="blog-post__category u-eyebrow">{data.category}</p>
        <h1 class="blog-post__title">{data.title}</h1>
        <p class="blog-post__description">{data.description}</p>
        <p class="blog-post__meta">{formattedDate} · {data.readingTime} min de lectura · Por {data.author}</p>
      </div>
    </header>

    <div class="blog-post__image u-container" aria-label={data.heroImageAlt}>
      <span>{data.category}</span>
    </div>

    <div class="blog-post__body u-container--narrow">
      <slot />
    </div>

    {data.ctaLabel && data.ctaLink && (
      <section class="blog-post__cta">
        <div class="blog-post__cta-inner u-container--narrow">
          <h2 class="blog-post__cta-title">Continúa el ritual.</h2>
          <p class="blog-post__cta-description">
            Explora más del universo XULA a través de sus productos y expresiones.
          </p>
          <Button href={data.ctaLink} label={data.ctaLabel} variant="primary" />
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .blog-post {
    background: var(--color-surface);
  }

  .blog-post__hero {
    padding-block: var(--section-gap) var(--space-12);
    background: var(--color-surface);
  }

  .blog-post__hero-inner {
    max-width: 860px;
  }

  .blog-post__title {
    max-width: 920px;
    margin-top: var(--space-4);
    color: var(--color-on-surface);
    font-size: var(--text-hero);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .blog-post__description {
    max-width: 720px;
    margin-top: var(--space-6);
    color: var(--color-on-surface-muted);
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
  }

  .blog-post__meta {
    margin-top: var(--space-5);
    color: var(--color-on-surface-muted);
    font-size: var(--text-body-sm);
  }

  .blog-post__image {
    display: grid;
    min-height: 420px;
    place-items: end start;
    margin-bottom: var(--space-16);
    padding: var(--space-8);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(circle at 20% 18%, var(--color-secondary-container), transparent 24rem),
      linear-gradient(145deg, var(--color-surface-deep), var(--color-surface-mid));
  }

  .blog-post__image span {
    border-radius: var(--radius-pill);
    background: var(--color-secondary);
    color: var(--color-on-secondary);
    font-size: var(--text-eyebrow);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    padding: var(--space-2) var(--space-4);
    text-transform: uppercase;
  }

  .blog-post__body {
    color: var(--color-on-surface);
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
  }

  .blog-post__body :global(*) {
    margin-block: 0;
  }

  .blog-post__body :global(* + *) {
    margin-top: var(--space-5);
  }

  .blog-post__body :global(h2) {
    margin-top: var(--space-10);
    color: var(--color-on-surface);
    font-size: var(--text-h2);
    line-height: var(--leading-snug);
  }

  .blog-post__body :global(blockquote) {
    margin-block: var(--space-10);
    border-left: 2px solid var(--color-tertiary);
    color: var(--color-tertiary);
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-style: italic;
    line-height: var(--leading-loose);
    padding-left: var(--space-6);
  }

  .blog-post__body :global(a) {
    color: var(--color-secondary);
  }

  .blog-post__cta {
    padding-block: var(--section-gap);
  }

  .blog-post__cta-inner {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    padding: var(--space-8);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    background: var(--color-surface-mid);
  }

  .blog-post__cta-title {
    color: var(--color-on-surface);
    font-size: var(--text-h2);
    line-height: var(--leading-snug);
  }

  .blog-post__cta-description {
    color: var(--color-on-surface-muted);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 640px) {
    .blog-post__image {
      min-height: 280px;
      margin-bottom: var(--space-10);
    }
  }
</style>
